        <mxCell id="steps" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=13;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#E7157B;" value="&lt;b&gt;Etapas do pipeline&lt;/b&gt;&lt;br&gt;1. Checkout do código&lt;br&gt;2. Login no ECR e build da imagem Docker&lt;br&gt;3. Push da imagem para o ECR&lt;br&gt;4. Nova revisão da task definition&lt;br&gt;5. Update do service (rolling update)&lt;br&gt;&lt;br&gt;As tasks fazem pull da imagem no ECR via NAT Gateway." vertex="1">
          <mxGeometry height="140" width="400" x="1215" y="580" as="geometry" />
        </mxCell>
        <mxCell id="iam" parent="1" style="rounded=1;arcSize=2;dashed=1;dashPattern=6 4;strokeColor=#DD344C;strokeWidth=2;fillColor=#FFF7F8;html=1;verticalAlign=top;align=left;spacingLeft=48;spacingTop=8;fontColor=#DD344C;fontStyle=1;fontSize=14;" value="IAM e Security Groups – privilégio mínimo" vertex="1">
          <mxGeometry height="335" width="450" x="1190" y="760" as="geometry" />
        </mxCell>
        <mxCell id="iamicon" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.role;" value="" vertex="1">
          <mxGeometry height="26" width="36" x="1200" y="768" as="geometry" />
        </mxCell>
        <mxCell id="iamtxt" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#232F3E;" value="&lt;b&gt;IAM Roles (somente o necessário)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ecs-task-execution-role&lt;/b&gt;: AmazonECSTaskExecutionRolePolicy (pull no ECR, logs no CloudWatch)&lt;br&gt;• &lt;b&gt;ecs-task-role&lt;/b&gt; (aplicação): apenas o que o backend usa, sem permissões extras&lt;br&gt;• &lt;b&gt;github-actions-role&lt;/b&gt;: ecr:GetAuthorizationToken + push no repositório; ecs:RegisterTaskDefinition, ecs:UpdateService, ecs:DescribeServices; iam:PassRole só das roles da task&lt;br&gt;&lt;br&gt;&lt;b&gt;Security Groups&lt;/b&gt;&lt;br&gt;• &lt;b&gt;alb-sg&lt;/b&gt;: in 80 &amp;lt; 0.0.0.0/0 · out 80/5000 &amp;gt; ecs-sgs&lt;br&gt;• &lt;b&gt;ecs-frontend-sg&lt;/b&gt;: in 80 &amp;lt; alb-sg · out 443 &amp;gt; NAT&lt;br&gt;• &lt;b&gt;ecs-backend-sg&lt;/b&gt;: in 5000 &amp;lt; alb-sg · out 3306 &amp;gt; rds-sg, 443 &amp;gt; NAT&lt;br&gt;• &lt;b&gt;rds-sg&lt;/b&gt;: in 3306 &amp;lt; ecs-backend-sg · sem outbound&lt;br&gt;• Sem SSH aberto; RDS sem acesso público" vertex="1">
          <mxGeometry height="285" width="425" x="1205" y="805" as="geometry" />
        </mxCell>
