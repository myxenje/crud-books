        <mxCell id="ecs" parent="1" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=13;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.ecs;" value="&lt;b&gt;Amazon ECS&lt;/b&gt;&lt;br&gt;cluster-crud-books&lt;br&gt;2 services · 2 tasks" vertex="1">
